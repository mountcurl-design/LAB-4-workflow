<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_LoanCredit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Loan_Credit_Eligibility_Process" name="Loan Credit Eligibility Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Received ​">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckCredit" name="Check Credit Score" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>REST Connector: POST the loan application to the Spring Boot credit-check service.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8081/api/credit-check" target="url" />
          <zeebe:input source='={"Content-Type": "application/json", "Accept": "application/json"}' target="headers" />
          <zeebe:input source='={"customerName": customerName, "monthlyIncome": monthlyIncome, "existingEmi": existingEmi, "loanAmount": loanAmount, "tenureMonths": tenureMonths}' target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="creditCheckResponse" />
          <zeebe:header key="retryBackoff" value="PT2S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Eligibility" name="Evaluate Eligibility ​" default="Flow_Other">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_Other</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Eligible" name="Eligible – Continue to Approval Review">
      <bpmn:incoming>Flow_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Manual" name="Manual Review / Reject">
      <bpmn:incoming>Flow_Other</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Eligible" name="Process Completed (eligible) ​">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Other" name="Process Completed (review / reject) ​">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckCredit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckCredit" targetRef="Gateway_Eligibility" />
    <bpmn:sequenceFlow id="Flow_Eligible" name="ELIGIBLE ​" sourceRef="Gateway_Eligibility" targetRef="Task_Eligible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditCheckResponse.body.decision = "ELIGIBLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Other" name="default: MANUAL_REVIEW / NOT_ELIGIBLE ​" sourceRef="Gateway_Eligibility" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Eligible" targetRef="End_Eligible" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Manual" targetRef="End_Other" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Loan_Credit_Eligibility_Process">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="126" y="245" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckCredit_di" bpmnElement="Task_CheckCredit">
        <dc:Bounds x="250" y="180" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Eligibility_di" bpmnElement="Gateway_Eligibility" isMarkerVisible="true">
        <dc:Bounds x="455" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="392" y="170" width="56" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Eligible_di" bpmnElement="Task_Eligible">
        <dc:Bounds x="620" y="70" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Manual_di" bpmnElement="Task_Manual">
        <dc:Bounds x="620" y="290" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Eligible_di" bpmnElement="End_Eligible">
        <dc:Bounds x="872" y="92" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="830" y="135" width="120" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Other_di" bpmnElement="End_Other">
        <dc:Bounds x="872" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="825" y="355" width="130" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="220" /><di:waypoint x="250" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="390" y="220" /><di:waypoint x="455" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eligible_di" bpmnElement="Flow_Eligible">
        <di:waypoint x="480" y="195" /><di:waypoint x="480" y="110" /><di:waypoint x="620" y="110" />
        <bpmndi:BPMNLabel><dc:Bounds x="510" y="88" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Other_di" bpmnElement="Flow_Other">
        <di:waypoint x="480" y="245" /><di:waypoint x="480" y="330" /><di:waypoint x="620" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="488" y="338" width="130" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="800" y="110" /><di:waypoint x="872" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="800" y="330" /><di:waypoint x="872" y="330" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>